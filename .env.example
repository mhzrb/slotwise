# Copy to .env and replace every value. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=slotwise
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Security ---
# HS256 signing key, at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Optional: bootstrap administrator created on first start (leave empty to skip)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin123

# --- Booking policy (durations such as 30m, 24h, 90d) ---
BOOKING_MIN_NOTICE=1h
BOOKING_CANCELLATION_CUTOFF=24h
BOOKING_RESCHEDULE_CUTOFF=24h

# --- Misc ---
APP_PORT=8080
POSTGRES_PORT=5432
API_DOCS_ENABLED=true
# SPRING_PROFILES_ACTIVE=dev
